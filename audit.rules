## ===========================
## Configurações Gerais
## ===========================
# Tamanho do buffer
-b 8192

# Remove any existing rules
-D

#failure mode
-f 1

#ignore errors
-i

# Ignorar eventos de baixo valor
-a never,exclude -F msgtype=PROCTITLE
-a never,exclude -F msgtype=CWD
-a never,exclude -F msgtype=CRYPTO_KEY_USER

## ===========================
## Monitoramento de Execuções
## ===========================
# Monitorar todos os comandos executados
-a exit,always -S execve

# Monitoramento de execução do comando 'which' 
-w /usr/bin/which -p x -k cmd_exec 

# Monitoramento de chamadas ao sistema execve (64 bits) 
-a always,exit -F arch=b64 -S execve -F key=process_tracking

# Monitorar execuções de binários críticos
-w /usr/bin/wget -p x -k susp_activity
-w /usr/bin/curl -p x -k susp_activity
-w /bin/nc -p x -k susp_activity
-w /usr/bin/python -p x -k susp_activity
-w /usr/bin/perl -p x -k susp_activity
-w /usr/bin/bash -p x -k susp_activity

# Suspicious activity
-w /usr/bin/wget -p x -k susp_activity
-w /usr/bin/curl -p x -k susp_activity
-w /usr/bin/base64 -p x -k susp_activity
-w /bin/nc -p x -k susp_activity
-w /bin/netcat -p x -k susp_activity
-w /usr/bin/ncat -p x -k susp_activity
-w /usr/bin/ss -p x -k susp_activity
-w /usr/bin/netstat -p x -k susp_activity
-w /usr/bin/ssh -p x -k susp_activity
-w /usr/bin/scp -p x -k susp_activity
-w /usr/bin/sftp -p x -k susp_activity
-w /usr/bin/ftp -p x -k susp_activity
-w /usr/bin/socat -p x -k susp_activity
-w /usr/bin/wireshark -p x -k susp_activity
-w /usr/bin/tshark -p x -k susp_activity
-w /usr/bin/rawshark -p x -k susp_activity
-w /usr/bin/rdesktop -p x -k susp_activity
-w /usr/local/bin/rdesktop -p x -k susp_activity
-w /usr/bin/wlfreerdp -p x -k susp_activity
-w /usr/bin/xfreerdp -p x -k susp_activity
-w /usr/local/bin/xfreerdp -p x -k susp_activity
-w /usr/bin/nmap -p x -k susp_activity


## ===========================
## Alterações em Configurações Críticas
## ===========================
# Monitorar mudanças em arquivos críticos
-w /etc/passwd -p wa -k etcpasswd
-w /usr/bin/passwd -p x -k passwd_modification
-w /etc/group -p wa -k etcgroup
-w /etc/shadow -p wa -k etcshadow
-w /etc/gshadow -p wa -k etcgshadow
-w /etc/hosts -p wa -k network_modifications
-w /etc/ld.so.preload -p wa -k ldpreload
-w /etc/pam.d/ -p wa -k pam
-w /bin/echo -p x -k echo
-w /bin/python -p x -k python
-w /usr/local/lib -p lib
-w /etc/sudoers -p wa -k actions
-w /etc/sudoers.d/ -p wa -k actions

## ===========================
## Escalonamento de Privilégios
## ===========================
# Monitorar uso de binários privilegiados
-w /bin/su -p x -k priv_esc
-w /usr/bin/sudo -p x -k priv_esc
-w /usr/bin/newgrp -p x -k priv_esc

# root ssh key tampering
-w /root/.ssh -p wa -k rootkey

# Monitoramento de criação de novos usuários
-w /etc/passwd -p wa -k user_addition

# Monitoramento de alterações em grupos de usuários
-w /etc/group -p wa -k group_changes

## ===========================
## Conexões de Rede
## ===========================
# Monitorar conexões IPv4
-a always,exit -F arch=b64 -S connect -F a2=16 -F success=1 -F key=network_connect_4

# Monitorar conexões IPv6
-a always,exit -F arch=b64 -S connect -F a2=28 -F success=1 -F key=network_connect_6

-a always,exit -F arch=b32 -S socket -F a0=2  -k network_socket_created
-a always,exit -F arch=b64 -S socket -F a0=2  -k network_socket_created

-a always,exit -F arch=b32 -S socket -F a0=10 -k network_socket_created
-a always,exit -F arch=b64 -S socket -F a0=10 -k network_socket_created
-a always,exit -F arch=b64 -F exe=/bin/bash -F success=1 -S connect -k "remote_shell"
-a always,exit -F arch=b64 -F exe=/usr/bin/bash -F success=1 -S connect -k "remote_shell"

## ===========================
## Modificações em Configurações de Segurança
## ===========================
# Alterações em auditd
-w /etc/audit/auditd.conf -p wa -k auditconfig
-w /etc/audit/rules.d/ -p wa -k auditrules

## SSH configuration
-w /etc/ssh/sshd_config -k sshd
-w /etc/ssh/sshd_config.d -k sshd


# Alterações no cron
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron

## ===========================
## Movimentação de Arquivos e Diretórios
## ===========================
# Monitorar movimentação ou modificação de arquivos importantes
-w /var/log/ -p wa -k logs
-w /tmp/ -p wa -k tmp_files
-a always,exit -F arch=b64 -S rmdir -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=-1 -k mass_delete
-a always,exit -F arch=b64 -S memfd_create -F key=anon_file_create


# Monitoramento de manipulação de arquivos compactados 
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/zip -F key=archive_activity 
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/unzip -F key=archive_activity 
-a always,exit -F arch=b64 -S execve -F path=/bin/tar -F key=archive_activity 
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/gzip -F key=archive_activity 
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/gunzip -F key=archive_activity 
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/7z -F key=archive_activity

#uftp ftp 
-w /usr/bin/uftp -p x -k susp_activity
-w /usr/sbin/uftp -p x -k susp_activity
-w /lib/systemd/system/uftp.service -k susp_activity
-w /usr/lib/systemd/system/uftp.service -k susp_activity
-w /usr/bin/atftpd -p x -k susp_activity
-w /usr/sbin/atftpd -p x -k susp_activity
-w /usr/bin/in.tftpd -p x -k susp_activity
-w /usr/sbin/in.tftpd -p x -k susp_activity
-w /lib/systemd/system/atftpd.service -k susp_activity
-w /usr/lib/systemd/system/atftpd.service -k susp_activity
-w /lib/systemd/system/atftpd.socket -k susp_activity
-w /usr/lib/systemd/system/atftpd.socket -k susp_activity

## ===========================
## Finalização
## ===========================
# Fim do arquivo de regras
# Certifique-se de reiniciar o auditd após editar este arquivo para aplicar as regras.
